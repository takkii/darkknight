<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="ja" lang="ja">

<head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/from_scss.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}></script>
</head>

<body>

    <!-- メインコンテンツ部分 -->

    <main class="main">

        <!-- メインヘッダー部分 -->

        <div id="header">
            <div id="header-inner">

                <table border="0" align="" cellpadding="0" cellspacing="0" width="780">
                    <tr>
                        <td>
                            <div id="table-left">
                                <h2><a href="http://pieceof.shop/">Welcome to Darkknight Web Sites.</a></h2>
                            </div>
                        </td>
                        <td>
                            <div id="table-right">
                                <ol class="breadcrumb-005">
                                    <li><a href="http://pieceof.shop/"> Home </a></li>
                                    <li><a href="https://github.com/takkii"> GitHub/Home </a></li>
                                    <li><a href="https://gist.github.com/takkii"> Gist/Home </a></li>
                                </ol>
                            </div>
                        </td>
                    </tr>
                </table>

            </div>
        </div>

        <!-- メインヘッダー終わり -->

        <div id="header-menu">
            <ul>
                <li><a href="https://github.com/takkii/golden_eagle">golden_eagle</a></li>
